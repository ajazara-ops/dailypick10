+// One native ad session; consumes both promise rejections and native error events.
+export type AdSessionState = { isLoaded: boolean; isClosed: boolean; error: boolean };
+type Ad = { load(): void; show(): Promise<unknown>; addAdEventsListener(listener: (event: {type:string; payload?:unknown}) => void): () => void };
+const empty = (): AdSessionState => ({isLoaded:false,isClosed:false,error:false});
+export function createInterstitialSession(ad: Ad, events: {LOADED:string; CLOSED:string; ERROR:string}, notify: (state:AdSessionState)=>void) {
+  let state=empty(), disposed=false, showing=false;
+  const update=(next:AdSessionState)=>{state=next;if(!disposed)notify({...state});};
+  const fail=()=>{showing=false;update({isLoaded:false,isClosed:false,error:true});};
+  const unsubscribe=ad.addAdEventsListener(({type})=>{
+    if(disposed)return;
+    if(type===events.LOADED)update({isLoaded:true,isClosed:false,error:false});
+    if(type===events.ERROR)fail();
+    if(type===events.CLOSED && showing){showing=false;update({isLoaded:false,isClosed:true,error:false});}
+  });
+  return {
+    load(){if(disposed || showing)return;update(empty());try{ad.load();}catch{fail();}},
+    async show(){
+      if(disposed || showing || !state.isLoaded)return false;
+      showing=true;update({...state,isClosed:false});
+      try{await ad.show();return !disposed && !state.error;}catch{if(!disposed)fail();return false;}
+    },
+    dispose(){disposed=true;showing=false;unsubscribe();},
+  };
+}
