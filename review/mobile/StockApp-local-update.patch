+import { useCallback, useEffect, useRef, useState } from 'react';
+import { AdEventType, InterstitialAd } from 'react-native-google-mobile-ads';
+import { createInterstitialSession, type AdSessionState } from './interstitialSession';
+
+export function useSafeInterstitial(adUnitId: string | null) {
+  const [state,setState]=useState<AdSessionState>({isLoaded:false,isClosed:false,error:false});
+  const active=useRef<ReturnType<typeof createInterstitialSession> | null>(null);
+  useEffect(()=>{
+    setState({isLoaded:false,isClosed:false,error:false});
+    if(adUnitId===null)return;
+    const session=createInterstitialSession(InterstitialAd.createForAdRequest(adUnitId,{requestNonPersonalizedAdsOnly:true}),AdEventType,setState);
+    active.current=session;
+    return ()=>{active.current=null;session.dispose();};
+  },[adUnitId]);
+  const load=useCallback(()=>active.current?.load(),[]);
+  const show=useCallback(()=>active.current?.show() ?? Promise.resolve(false),[]);
+  return {...state,load,show};
+}
