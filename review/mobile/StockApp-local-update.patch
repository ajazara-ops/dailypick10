diff --git a/b/emulator-tests/app-deletion.test.cjs b/emulator-tests/app-deletion.test.cjs
new file mode 100644
index 0000000..b963015
--- /dev/null
+++ b/emulator-tests/app-deletion.test.cjs
@@ -0,0 +1,135 @@
+// Actual app service/domain + installed Firebase JS SDK + local HTTP/Auth/Firestore.
+// No offline-test mock is imported. The test clock/control channel is harness-only.
+const {test,beforeEach,afterEach}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const crypto=require('node:crypto');
+const ts=require('typescript');
+const project='demo-dailypick10-deletion';
+const base='http://127.0.0.1:18781';
+assert.equal(process.env.DAILYPICK10_APP_EMULATOR_TEST,'1');
+assert.equal(process.env.GCLOUD_PROJECT,project);
+assert.equal(process.env.FIREBASE_AUTH_EMULATOR_HOST,'127.0.0.1:19099');
+assert.equal(process.env.FIRESTORE_EMULATOR_HOST,'127.0.0.1:18080');
+assert.ok(process.env.DAILYPICK10_LOCAL_TEST_KEY);
+const actualFetch=global.fetch;
+global.fetch=(input,options)=>{
+  const url=new URL(typeof input==='string'?input:input.url||String(input));
+  if(url.protocol!=='http:'||url.hostname!=='127.0.0.1'||!['19099','18080','18781'].includes(url.port))throw Error('Non-local HTTP forbidden');
+  return actualFetch(input,{...options,redirect:'error'});
+};
+require.extensions['.ts']=(module,file)=>module._compile(ts.transpileModule(fs.readFileSync(file,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,file);
+const {initializeApp,deleteApp}=require('firebase/app');
+const {getAuth,connectAuthEmulator,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut,EmailAuthProvider,reauthenticateWithCredential}=require('firebase/auth');
+const {getFirestore,connectFirestoreEmulator,setDoc,getDoc,doc}=require('firebase/firestore/lite');
+const {createEmulatorDeletionTransport,accountDeletionTransport}=require('../src/services/accountDeletion.ts');
+const {createDeletionClient}=require('../src/domain/deletion.ts');
+let app,auth,db,uid,email,password,storage,file,transport,client;
+const control=async(operation,extra={})=>{
+  const response=await fetch(base+'/__test__/control',{method:'POST',headers:{'Content-Type':'application/json','X-Local-Test-Key':process.env.DAILYPICK10_LOCAL_TEST_KEY},body:JSON.stringify({operation,...extra})});
+  assert.equal(response.status,200);return response.json();
+};
+const registerSignin=async()=>control('signin',{token:await auth.currentUser.getIdToken()});
+const reauth=async()=>{await reauthenticateWithCredential(auth.currentUser,EmailAuthProvider.credential(email,password));await registerSignin();return true;};
+const makeTransport=()=>createEmulatorDeletionTransport({projectId:project,baseUrl:base,auth,storage,crypto:crypto.webcrypto});
+const makeClient=()=>{transport=makeTransport();return createDeletionClient(transport,()=>auth.currentUser?.uid||null);};
+beforeEach(async()=>{
+  await control('reset');
+  app=initializeApp({apiKey:'synthetic-only',projectId:project,authDomain:project+'.invalid'},crypto.randomUUID());
+  auth=getAuth(app);connectAuthEmulator(auth,'http://127.0.0.1:19099',{disableWarnings:true});
+  db=getFirestore(app);connectFirestoreEmulator(db,'127.0.0.1',18080);
+  email='synthetic-'+crypto.randomUUID()+'@example.invalid';password='Local-Only-Example-123!';
+  uid=(await createUserWithEmailAndPassword(auth,email,password)).user.uid;await registerSignin();
+  await setDoc(doc(db,'users',uid),{favoriteIds:['SYNTHETIC'],pushToken:'synthetic-not-deliverable'});
+  file=path.join(process.env.TEMP,'deletion-receipt-'+crypto.randomUUID()+'.json');
+  storage={load:async()=>fs.existsSync(file)?JSON.parse(fs.readFileSync(file,'utf8')):null,save:async value=>fs.writeFileSync(file,JSON.stringify(value),{mode:0o600})};
+  client=makeClient();await client.initialize();
+  assert.equal(client.snapshot().status,'idle');assert.equal(client.canUseService(uid),true);
+});
+afterEach(async()=>{
+  if(auth?.currentUser)await signOut(auth);
+  if(app)await deleteApp(app);
+  if(file&&fs.existsSync(file))fs.unlinkSync(file); // Only the file this test created.
+});
+
+test('actual SDK reauth cancellation/failure submits nothing; explicit request/cancel restores rules access',async()=>{
+  await client.request(async()=>false);assert.equal(client.snapshot().status,'idle');
+  await client.request(async()=>{await reauthenticateWithCredential(auth.currentUser,EmailAuthProvider.credential(email,'incorrect-synthetic-password'));return true;});
+  assert.equal(client.snapshot().status,'idle');assert.equal(await transport.current(),null);
+  await client.request(reauth);
+  assert.equal(client.snapshot().mode,'emulator');assert.equal(client.snapshot().status,'grace_period');
+  const receipt=client.snapshot().receipt;assert.equal(receipt.deleteAfter-receipt.requestedAt,604800);
+  assert.equal(client.canUseService(uid),false);assert.equal(receipt.subscriptionCancelled,false);
+  await assert.rejects(setDoc(doc(db,'users',uid),{late:'autosave'}),error=>error.code==='permission-denied');
+  await client.cancel(async()=>false);assert.equal(client.snapshot().status,'grace_period');
+  await client.cancel(reauth);assert.equal(client.snapshot().status,'cancelled');assert.equal(client.canUseService(uid),true);
+  await setDoc(doc(db,'users',uid),{favoriteIds:['RESTORED']});assert.equal((await getDoc(doc(db,'users',uid))).exists(),true);
+});
+
+test('relogin and repeated request preserve server deadline; explicit cancellation succeeds just before expiry',async()=>{
+  await client.request(reauth);const first=client.snapshot().receipt;
+  await signOut(auth);await signInWithEmailAndPassword(auth,email,password);await registerSignin();
+  client=makeClient();await client.initialize();assert.equal(client.snapshot().status,'grace_period');
+  await client.request(reauth);assert.equal(client.snapshot().receipt.deleteAfter,first.deleteAfter);
+  await control('advance',{seconds:604799});await client.refresh();assert.equal(client.snapshot().receipt.cancelAllowed,true);
+  await client.cancel(reauth);assert.equal(client.snapshot().status,'cancelled');
+});
+
+test('server deadline yields queued, worker processing/retry/completion comes over HTTP and saved proof after Auth deletion',async()=>{
+  await client.request(reauth);const requestId=client.snapshot().receipt.requestId;
+  await control('advance',{seconds:604800});await reauth();await client.refresh();
+  assert.equal(client.snapshot().status,'queued');assert.equal(client.snapshot().receipt.cancelAllowed,false);
+  await client.cancel(reauth);assert.equal(client.snapshot().status,'queued');
+  await control('claim',{requestId});await client.refresh();assert.equal(client.snapshot().status,'processing');
+  await control('advance',{seconds:60});await control('fault',{name:'profile_fail_once'});
+  await control('work',{requestId});await client.refresh();assert.equal(client.snapshot().status,'retry_wait');
+  // Admin deleted Auth, but SDK currentUser is still cached. The real client uses saved proof.
+  assert.ok(auth.currentUser);assert.equal(client.canUseService(uid),false);
+  await control('advance',{seconds:4});await control('work',{requestId});
+  client=makeClient();await client.initialize();assert.equal(client.snapshot().status,'completed');
+  assert.deepEqual(client.snapshot().receipt.completedScope,['firebase-auth','users-document']);
+  assert.equal(client.snapshot().receipt.subscriptionCancelled,false);
+  await signOut(auth);await client.refresh();assert.equal(client.snapshot().status,'completed');
+  await assert.rejects(signInWithEmailAndPassword(auth,email,password));
+});
+
+test('actual socket response loss leaves unknown then durable client restart recovers the same accepted request',async()=>{
+  await control('fault',{name:'lose_response'});await client.request(reauth);
+  assert.equal(client.snapshot().status,'unknown');assert.equal(client.canUseService(uid),false);
+  const saved=await storage.load();assert.ok(saved);
+  client=makeClient();await client.initialize();assert.equal(client.snapshot().status,'grace_period');
+  const before=client.snapshot().receipt;assert.equal(before.requestId,saved.requestId);
+  await client.request(reauth);assert.equal(client.snapshot().receipt.deleteAfter,before.deleteAfter);
+});
+
+test('stale cancellation button is rejected at server deadline and refresh shows pending, not success',async()=>{
+  await client.request(reauth);await control('advance',{seconds:604800});
+  assert.equal(client.snapshot().receipt.cancelAllowed,true);
+  await client.cancel(reauth);assert.equal(client.snapshot().status,'unknown');
+  await client.refresh();assert.equal(client.snapshot().status,'queued');
+});
+
+test('real HTTP boundary requires Auth and rejects forged fields, other request owners and local control callers',async()=>{
+  const call=(route,body,token)=>fetch(base+route,{method:'POST',headers:{'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})},body:JSON.stringify(body)});
+  const prepared=transport.prepare(uid);await transport.save(prepared);
+  const body={version:1,requestId:prepared.requestId,recoveryKey:prepared.recoveryKey,confirmation:'DELETE_MY_ACCOUNT'};
+  assert.equal((await call('/__emulator__/v1/account-deletion/request',body)).status,401);
+  assert.equal((await call('/v1/account-deletion/request',body,await auth.currentUser.getIdToken())).status,503);
+  assert.equal((await call('/__test__/control',{operation:'advance',seconds:604800})).status,403);
+  for(const extra of [{uid:'another-uid'},{deleteAfter:0},{status:'completed'}])assert.equal((await call('/__emulator__/v1/account-deletion/request',{...body,...extra},await auth.currentUser.getIdToken())).status,400);
+  await client.request(reauth);const requestId=client.snapshot().receipt.requestId;
+  await signOut(auth);await createUserWithEmailAndPassword(auth,'synthetic-'+crypto.randomUUID()+'@example.invalid',password);await registerSignin();
+  assert.equal((await call('/__emulator__/v1/account-deletion/cancel',{version:1,requestId,confirmation:'CANCEL_ACCOUNT_DELETION'},await auth.currentUser.getIdToken())).status,401);
+});
+
+test('transport rejects nonlocal endpoints and changing user before token resolution without making a request',async()=>{
+  assert.equal(accountDeletionTransport.mode,'disabled');
+  assert.throws(()=>createEmulatorDeletionTransport({projectId:'real-project',baseUrl:base}),/local demo/);
+  assert.throws(()=>createEmulatorDeletionTransport({projectId:project,baseUrl:'https://example.invalid'}),/local demo/);
+  let resolve;const fakeUser={uid,getIdToken:()=>new Promise(done=>resolve=done)};
+  const changingAuth={currentUser:fakeUser};
+  const t=createEmulatorDeletionTransport({projectId:project,baseUrl:base,auth:changingAuth,storage,crypto:crypto.webcrypto});
+  const pending=t.current();changingAuth.currentUser={uid:'different-user'};resolve('synthetic-token-not-sent');
+  await assert.rejects(pending,/Account changed/);assert.equal(await transport.current(),null);
+});
