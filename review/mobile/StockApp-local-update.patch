+++ b/emulator-tests/spark-intake.test.cjs
@@ -0,0 +1,140 @@
+// Synthetic accounts and actual SDK calls to loopback Auth/Firestore only.
+const {test,beforeEach,afterEach}=require('node:test');
+const assert=require('node:assert/strict'),fs=require('node:fs'),crypto=require('node:crypto'),ts=require('typescript');
+const project='demo-dailypick10-deletion';
+assert.equal(process.env.DAILYPICK10_SPARK_TEST,'1');
+assert.equal(process.env.GCLOUD_PROJECT,project);
+assert.equal(process.env.FIREBASE_AUTH_EMULATOR_HOST,'127.0.0.1:19099');
+assert.equal(process.env.FIRESTORE_EMULATOR_HOST,'127.0.0.1:18080');
+const nativeFetch=global.fetch;
+global.fetch=(input,options)=>{
+ const u=new URL(typeof input==='string'?input:input.url||String(input));
+ if(u.protocol!=='http:'||u.hostname!=='127.0.0.1'||!['19099','18080','14400'].includes(u.port))throw Error('External request forbidden');
+ return nativeFetch(input,{...options,redirect:'error'});
+};
+require.extensions['.ts']=(m,f)=>m._compile(ts.transpileModule(fs.readFileSync(f,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText,f);
+const {initializeApp,deleteApp}=require('firebase/app');
+const {getAuth,connectAuthEmulator,createUserWithEmailAndPassword,signOut,signInWithEmailAndPassword}=require('firebase/auth');
+const F=require('firebase/firestore/lite');
+const {createLocalSparkIntake}=require('../src/services/sparkDeletionIntake.ts');
+let app,auth,db,uid,email,client,first;
+const password='Synthetic-Local-Only-123!';
+const state=()=>F.doc(db,'accountDeletionIntents',uid);
+const profile=()=>F.doc(db,'users',uid);
+const denied=async promise=>assert.rejects(promise,e=>e.code==='permission-denied');
+async function adminPatch(fields){
+  const encoded={};for(const [k,v]of Object.entries(fields))encoded[k]=k==='requestedAt'?{timestampValue:v}:typeof v==='number'?{integerValue:String(v)}:{stringValue:v};
+ const q=Object.keys(fields).map(k=>'updateMask.fieldPaths='+k).join('&');
+ const r=await fetch('http://127.0.0.1:18080/v1/projects/'+project+'/databases/(default)/documents/accountDeletionIntents/'+uid+'?'+q,{method:'PATCH',headers:{Authorization:'Bearer owner','Content-Type':'application/json'},body:JSON.stringify({fields:encoded})});
+ assert.equal(r.status,200);
+}
+async function confirmCancel(){
+ const base='http://127.0.0.1:18080/v1/projects/'+project+'/databases/(default)/documents';
+ const root='projects/'+project+'/databases/(default)/documents/';
+ const headers={Authorization:'Bearer owner','Content-Type':'application/json'};
+ const profileRead=await fetch(base+'/users/'+uid,{headers});
+ assert.ok([200,404].includes(profileRead.status));
+ const writes=[{update:{name:root+'accountDeletionIntents/'+uid,fields:{status:{stringValue:'cancelled'}}},updateMask:{fieldPaths:['status']},updateTransforms:[{fieldPath:'cancelledAt',setToServerValue:'REQUEST_TIME'}]}];
+ if(profileRead.status===200)writes.push({update:{name:root+'users/'+uid,fields:{}},updateMask:{fieldPaths:['deletionRequest']}});
+ const r=await fetch(base+':commit',{method:'POST',headers,body:JSON.stringify({writes})});assert.equal(r.status,200);
+}
+beforeEach(async()=>{
+ app=initializeApp({apiKey:'synthetic-only',projectId:project},crypto.randomUUID());
+ auth=getAuth(app);connectAuthEmulator(auth,'http://127.0.0.1:19099',{disableWarnings:true});
+ db=F.getFirestore(app);F.connectFirestoreEmulator(db,'127.0.0.1',18080);
+ email='spark-'+crypto.randomUUID()+'@example.invalid';uid=(await createUserWithEmailAndPassword(auth,email,password)).user.uid;
+ await F.setDoc(profile(),{favoriteIds:['SYNTHETIC'],pushToken:'synthetic-unusable'});
+ client=createLocalSparkIntake(auth,db);first=crypto.randomUUID();
+});
+afterEach(async()=>{if(auth.currentUser)await signOut(auth);await deleteApp(app);});
+
+test('server timestamp request and pending cancel block access; only server confirmation clears marker',async()=>{
+ const accepted=await client.request(first,'DELETE_MY_ACCOUNT');assert.equal(accepted.status,'grace_period');
+ assert.ok(accepted.requestedAt instanceof F.Timestamp);assert.equal(accepted.requestId,first);
+ await denied(F.getDoc(profile()));await denied(F.setDoc(profile(),{late:true}));
+  const result=await client.cancel(first,'CANCEL_ACCOUNT_DELETION');assert.equal(result.status,'cancel_requested');
+  await denied(F.getDoc(profile()));await denied(F.updateDoc(state(),{status:'cancelled'}));
+  await confirmCancel();
+ assert.equal((await F.getDoc(profile())).data().deletionRequest,undefined);
+ await F.setDoc(profile(),{restored:true});
+});
+test('duplicate and concurrent requests plus relogin keep the first server timestamp',async()=>{
+ const results=await Promise.all([client.request(first,'DELETE_MY_ACCOUNT'),client.request(crypto.randomUUID(),'DELETE_MY_ACCOUNT')]);
+ assert.equal(results[0].requestId,results[1].requestId);
+ const original=results[0];await signOut(auth);await signInWithEmailAndPassword(auth,email,password);
+ const result=await client.request(crypto.randomUUID(),'DELETE_MY_ACCOUNT');
+ assert.ok(original.requestedAt.isEqual(result.requestedAt));assert.equal(result.status,'grace_period');
+});
+test('old request identifiers cannot resubmit after explicit cancellation or later cancelled cycles',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');await client.cancel(first,'CANCEL_ACCOUNT_DELETION');
+  await confirmCancel();
+  const second=crypto.randomUUID();await client.request(second,'DELETE_MY_ACCOUNT');await client.cancel(second,'CANCEL_ACCOUNT_DELETION');await confirmCancel();
+ await assert.rejects(client.request(first,'DELETE_MY_ACCOUNT'),/cannot be replayed/);
+ assert.equal((await client.current()).status,'cancelled');
+});
+test('client cannot set UID, deadline, completed status, timestamp or remove lifecycle record',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');
+  for(const patch of [{uid:'other'},{deleteAfter:0},{status:'completed'},{consentAuthTime:0},{requestedAt:F.Timestamp.now()},{requestId:crypto.randomUUID()}])await denied(F.updateDoc(state(),patch));
+ await denied(F.deleteDoc(state()));await denied(F.deleteDoc(profile()));
+ await denied(F.updateDoc(profile(),{deletionRequest:F.deleteField()}));
+ await denied(F.setDoc(F.doc(db,'accountDeletionJobs',first),{status:'completed'}));
+});
+test('cross-user and anonymous access are denied',async()=>{
+ const other=F.doc(db,'accountDeletionIntents','some-other-synthetic-uid');
+ await denied(F.getDoc(other));await denied(F.setDoc(other,{status:'grace_period'}));
+ await client.request(first,'DELETE_MY_ACCOUNT');await signOut(auth);await denied(F.getDoc(state()));
+});
+test('request without atomic marker/history is rejected',async()=>{
+  const consentAuthTime=(await auth.currentUser.getIdTokenResult()).claims.auth_time;
+  await denied(F.setDoc(state(),{version:2,requestId:first,requestedAt:F.serverTimestamp(),status:'grace_period',confirmation:'DELETE_MY_ACCOUNT',consentAuthTime,profilePresent:true,cancelledAt:null}));
+ assert.equal(await client.current(),null);assert.equal((await F.getDoc(profile())).data().deletionRequest,undefined);
+});
+test('cancellation before seven days succeeds; after seven days rules reject it',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');
+ await adminPatch({requestedAt:new Date(Date.now()-604790000).toISOString()});
+ await client.cancel(first,'CANCEL_ACCOUNT_DELETION');
+  await confirmCancel();
+ const second=crypto.randomUUID();await client.request(second,'DELETE_MY_ACCOUNT');
+ await adminPatch({requestedAt:new Date(Date.now()-604801000).toISOString()});
+ await denied(client.cancel(second,'CANCEL_ACCOUNT_DELETION'));assert.equal((await client.current()).status,'grace_period');
+});
+test('processing and completed server states cannot be cancelled or reset',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');
+ for(const status of ['processing','retry_wait','completed']){
+  await adminPatch({status});await assert.rejects(client.cancel(first,'CANCEL_ACCOUNT_DELETION'),/Cancellation closed/);
+  await denied(F.updateDoc(state(),{status:'cancelled',cancelledAt:F.serverTimestamp(),confirmation:'CANCEL_ACCOUNT_DELETION'}));
+  assert.equal((await client.request(crypto.randomUUID(),'DELETE_MY_ACCOUNT')).status,status);
+ }
+});
+test('old auth_time cannot cancel even when the unsigned emulator token remains unexpired',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');
+ const token=await auth.currentUser.getIdToken(),parts=token.split('.'),claims=JSON.parse(Buffer.from(parts[1],'base64url'));
+ claims.auth_time=Math.floor(Date.now()/1000)-301;parts[1]=Buffer.from(JSON.stringify(claims)).toString('base64url');
+  const r=await fetch('http://127.0.0.1:18080/v1/projects/'+project+'/databases/(default)/documents:commit',{method:'POST',headers:{Authorization:'Bearer '+parts.join('.'),'Content-Type':'application/json'},body:JSON.stringify({writes:[{update:{name:'projects/'+project+'/databases/(default)/documents/accountDeletionIntents/'+uid,fields:{status:{stringValue:'cancel_requested'},confirmation:{stringValue:'CANCEL_ACCOUNT_DELETION'},cancelAuthTime:{integerValue:String(claims.auth_time)}}},updateMask:{fieldPaths:['status','confirmation','cancelAuthTime']},updateTransforms:[{fieldPath:'cancelRequestedAt',setToServerValue:'REQUEST_TIME'}]}]})});
+ assert.equal(r.status,403);assert.equal((await client.current()).status,'grace_period');
+});
+test('lost acknowledgement is recoverable by current() without another request or extended deadline',async()=>{
+ await client.request(first,'DELETE_MY_ACCOUNT');const initial=await client.current();
+ client=createLocalSparkIntake(auth,db);const recovered=await client.current();
